root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cs,js,shader,txt,md,json,yml,yaml}]
indent_style = space
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[*.{json,yml,yaml}]
indent_size = 2

[*.cs]
# Keep Unity C# conventions consistent with the rest of the project.

dotnet_sort_system_directives_first = true

[*.js]
# Legacy UnityScript files are intentionally kept close to original styling.
